erDiagram

```
USER {
    int id
    string name
    string email
    string role
}

DIRECTOR {
    int user_id
}

COLLABORATORS {
    int user_id
}

PROJECT_MANAGER {
    int user_id
}

TEAM {
    int id
    int user_id
    string name
}

FINANCIER {
    int id
    int user_id
}

PROJECT {
    int id
    int author_id
    string title
    text form_data
    string status
    datetime created_at
}

PROJECT_PROPOSAL {
    int id
    int project_id
    datetime created_at
}

ARCHIVE_OF_REJECTED {
    int id
    int project_id
    datetime rejected_at
}

COMMENT {
    int id
    int project_id
    int author_id
    text content
    datetime created_at
}

PROJECTS_APPROVED_FOR_FUNDING {
    int id
    int project_id
    int financier_id
    datetime approved_at
}

PROJECTS_APPROVED {
    int id
    int project_id
    int team_id
    int project_manager_id
    int comment_id
    datetime approved_at
}

ARCHIVE_OF_COMPLETED {
    int id
    int project_id
    datetime completed_at
}

USER ||--o| DIRECTOR : is
USER ||--o| COLLABORATORS : is
USER ||--o| PROJECT_MANAGER : is
USER ||--o| FINANCIER : is

USER ||--o{ PROJECT : creates

COLLABORATORS }o--o{ PROJECT : participates

PROJECT ||--o| PROJECT_PROPOSAL : proposed

PROJECT ||--o| ARCHIVE_OF_REJECTED : rejected

PROJECT ||--o| ARCHIVE_OF_COMPLETED : completed

PROJECT ||--o{ COMMENT : has
USER ||--o{ COMMENT : writes

PROJECT ||--o| PROJECTS_APPROVED : approved

TEAM ||--o{ PROJECTS_APPROVED : realizes
PROJECT_MANAGER ||--o{ PROJECTS_APPROVED : manages

PROJECT ||--o| PROJECTS_APPROVED_FOR_FUNDING : funded
FINANCIER ||--o{ PROJECTS_APPROVED_FOR_FUNDING : finances
```
