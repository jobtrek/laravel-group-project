erDiagram

    USER {
        int id
        string name
        string email
        string role
    }

    director {
        int user_id
    }

    collaborators {
        int user_id
    }

    project_manager {
        int user_id
    }

    team {
        int id
        int user_id
        string name
    }

    financier {
        int id
        int user_id
    }

    PROJECT {
        int id
        int author_id
        string title
        text form_data
        string status
        datetime created_at
    }

    project_proposal {
        int id
        int project_id
        datetime created_at
    }

    archive_of_rejected {
        int id
        int project_id
        datetime rejected_at
    }

    COMMENT {
        int id
        int project_id
        int author_id
        text content
        datetime created_at
    }

    projects_approved_for_funding {
        int id
        int project_id
        int financier_id
        datetime approved_at
    }

    projects_approved {
        int id
        int project_id
        int team_id
        int project_manager_id
        int COMMENT_id
        datetime approved_at
    }

    archive_of_completed {
        int id
        int project_id
        datetime completed_at
    }

    USER ||--|| collaborators : be
    collaborators }o--|| PROJECT : created

    project_proposal ||--o{ PROJECT : checking

