erDiagram

ROLE {
    int id
    string name
}

USER {
    int id
    string name
    string email
    int role_id
}

TEAM {
    int id
    int user_id
    string name
}

PROJECT {
    int id
    int author_id
    string title
    text form_data
    string status
    datetime created_at
}

PROJECT_PROPOSAL {
    int id
    int project_id
    datetime created_at
}

ARCHIVE {
    int id
    int project_id
    string status
    datetime created_at
}

COMMENT {
    int id
    int project_id
    int author_id
    text content
    datetime created_at
}

PROJECTS_APPROVED_FOR_FUNDING {
    int id
    int project_id
    int financier_id
    datetime approved_at
}

PROJECTS_APPROVED {
    int id
    int project_id
    int team_id
    int project_manager_id
    int comment_id
    datetime approved_at
}

%% ROLE relations
ROLE ||--o{ USER : has

%% USER relations
USER ||--o{ PROJECT : creates
USER ||--o{ COMMENT : writes

%% COLLABORATION
USER }o--o{ PROJECT : participates

%% PROJECT relations
PROJECT ||--o| PROJECT_PROPOSAL : proposed
PROJECT ||--o{ ARCHIVE : archived
PROJECT ||--o{ COMMENT : has
PROJECT ||--o| PROJECTS_APPROVED : approved
PROJECT ||--o| PROJECTS_APPROVED_FOR_FUNDING : funded

%% TEAM / APPROVAL
TEAM ||--o{ PROJECTS_APPROVED : realizes
USER ||--o{ PROJECTS_APPROVED : manages
USER ||--o{ PROJECTS_APPROVED_FOR_FUNDING : finances